# Copy to .env.cloudflare. That local file is ignored by Git.
# Use a scoped Cloudflare deployment API token, not a Global API Key.
# Never paste the token into chat. Do not enable cash billing automatically.
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=****
# Optional existing hostname. A Workers hostname can be used initially.
ENGRAM_PUBLIC_HOSTNAME=
