# Copy to .env.collective. Literal **** values are deliberately NOT usable keys.
ANTHROPIC_API_KEY=****
AGENT_PROVIDER=groq
GROQ_API_KEY=****
AGENT_MODEL=qwen/qwen3.8-27b
JEV_API_KEY=****
DECISION_PROVIDER=safeguard
SAFEGUARD_MODEL=openai/gpt-oss-safeguard-20b
DECISION_URL=http://127.0.0.1:8009/v1/systemone
JEV_MODEL=jev-latest
TAVILY_API_KEY=****
WEB_SEARCH_PROVIDER=langsearch
LANGSEARCH_API_KEY=****
LANGSEARCH_DAILY_LIMIT=1000
DATABASE_URL=postgresql://engram:engram-local@127.0.0.1:55432/engram
FALKOR_HOST=127.0.0.1
FALKOR_PORT=56379
FALKOR_PASSWORD=engram-graph-local
FALKOR_USERNAME=default
FALKOR_TLS=false
QDRANT_URL=http://127.0.0.1:56333
QDRANT_API_KEY=
# Cloud containers require postgres history. Local installations can retain sqlite.
MEM0_HISTORY_BACKEND=sqlite
ARTIFACT_BACKEND=local
ARTIFACT_SERVICE_ORIGIN=
ARTIFACT_SERVICE_TOKEN=
ARTIFACT_BUCKET=engram-collective-artifacts
EMBEDDING_URL=http://127.0.0.1:8091/v1
EMBEDDING_MODEL=mxbai-embed-large-v1
EMBEDDING_DIMENSION=1024
MAX_PARALLEL_AGENTS=3
MAX_AGENT_STEPS=48
MAX_TOOL_CALLS=32
MAX_RUN_SECONDS=1800
GROQ_MAX_OUTPUT_TOKENS=1000
MEMORY_MAX_OUTPUT_TOKENS=2000
MEMORY_BUDGET_TOKENS=2000
COOKIE_SECURE=false
